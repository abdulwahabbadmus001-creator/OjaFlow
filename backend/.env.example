APP_ENV=development
APP_NAME=OjaFlow API
DATABASE_URL=sqlite:///./ojaflow.db
FRONTEND_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-this-with-a-long-random-secret-before-production
SESSION_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# OTP: console lets you test today without SMS. Switch to termii for production.
OTP_PROVIDER=console
OTP_TTL_MINUTES=5
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=OjaFlow
TERMII_CHANNEL=generic

# OjaChat. Leave blank and local OjaChat answers still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite